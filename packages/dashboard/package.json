{
  "name": "@agent-profiler/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "styles": "sass src/styles/dashboard.scss public/styles.css --no-source-map --style=expanded",
    "styles:watch": "sass src/styles/dashboard.scss public/styles.css --watch --no-source-map --style=expanded",
    "build": "npm run styles && rollup -c"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.61.0",
    "sass": "^1.100.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
