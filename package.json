{
  "name": "agent-profiler",
  "version": "0.0.0-semantically-released",
  "description": "Local-first profiling for AI coding agents.",
  "keywords": [
    "agent",
    "profiler",
    "cli",
    "cursor",
    "codex",
    "claude",
    "opencode",
    "telemetry",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cleverb/agent-profiler.git"
  },
  "homepage": "https://github.com/cleverb/agent-profiler#readme",
  "bugs": {
    "url": "https://github.com/cleverb/agent-profiler/issues"
  },
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/dashboard",
    "packages/opencode-telemetry-plugin"
  ],
  "bin": {
    "agent-profiler": "./dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "assets/dashboard.png"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc && npm run build --workspace=@agent-profiler/dashboard && node scripts/copy-build-assets.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check . --ignore-unknown --ignore-path .gitignore",
    "format:fix": "prettier --write . --ignore-unknown --ignore-path .gitignore",
    "lint": "npm run typecheck",
    "lint-staged": "lint-staged",
    "smoke:cli": "node scripts/smoke-cli.js",
    "smoke:dashboard": "node scripts/smoke-dashboard.mjs",
    "pack:dry-run": "npm run build && npm pack --dry-run --ignore-scripts",
    "pack:opencode": "npm pack --workspace=@agent-profiler/opencode-telemetry-plugin --dry-run",
    "prepare": "husky",
    "prepublishOnly": "npm run build && node scripts/prepublish-checks.js",
    "prerelease": "npm run build && node scripts/prepublish-checks.js",
    "release": "npm run build && semantic-release",
    "release:canary": "npm run build && npm_config_provenance=true auto canary",
    "adr-skill": "node .agents/skills/adr-agent-skill/bin/cli.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "commander": "^15.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@picocss/pico": "^2.1.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/html-vite": "^10.4.6",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@vueless/storybook-dark-mode": "10.0.8",
    "storybook-addon-decision-records": "0.1.1--canary.45a0b0c.0",
    "storybook-addon-tag-badges": "^3.1.0",
    "@types/node": "^26.1.0",
    "auto": "^11.3.6",
    "boxen": "^8.0.1",
    "commitlint": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "semantic-release": "^25.0.5",
    "storybook": "^10.4.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "zx": "^8.8.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
